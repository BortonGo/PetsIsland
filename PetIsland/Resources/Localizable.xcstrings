    "%@ carefully counted the scales. Then lost count. It is a very good pinecone anyway." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ carefully counted the scales. Then lost count. It is a very good pinecone anyway."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ старательно считает чешуйки. Сбивается и начинает снова. В любом случае, шишка замечательная."
          }
        }
      }
    },
    "%@ caught a leaf before it touched the ground. A little piece of sunshine, saved for later." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ caught a leaf before it touched the ground. A little piece of sunshine, saved for later."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ловит листик, пока тот не коснулся земли. Маленький кусочек солнца — на память."
          }
        }
      }
    },
    "%@ checked every leaf. This one has enough luck for both of you." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ checked every leaf. This one has enough luck for both of you."
