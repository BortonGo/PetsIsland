        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ проверяет каждый листочек. У этого клевера хватит удачи на вас обоих!"
          }
        }
      }
    },
    "%@ chose the smoothest stone on the beach. A tiny piece of calm to bring home." : {
