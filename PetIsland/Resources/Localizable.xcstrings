        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ смотрит, как пёрышко медленно кружится в воздухе. Наверное, это подарок от неба."
          }
        }
      }
    },
    "%@ found a tiny hat with an acorn underneath. A whole tree, tucked into your album." : {
